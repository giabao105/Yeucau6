            price_slider = gr.Slider(minimum=100000, maximum=5000000, value=1000000, step=50000, label="Lọc Giá nhà tối đa")
            plot_output = gr.Plot()
            price_slider.change(fn=plot_interactive, inputs=price_slider, outputs=plot_output)
            
