def predict_price(sqft, beds):
    # Dự đoán giá nhà dựa trên dữ liệu người dùng nhập
    pred = model.predict([[sqft, beds]])
    return f"Giá nhà dự kiến: ${pred[0]:,.0f}"

def plot_interactive(max_price):
    # Vẽ biểu đồ tương tác
    df_filtered = df_clean[df_clean['price'] <= max_price]
    fig, ax = plt.subplots(figsize=(8, 4))
    sns.histplot(df_filtered['price'], bins=30, kde=True, ax=ax, color='purple')
    ax.set_title('Phan bo Gia nha')
    return fig

with gr.Blocks() as dashboard:
